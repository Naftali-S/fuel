{
  "name": "fuel",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "data:cnf": "tsx scripts/data/build-cnf.ts",
    "data:off-ca": "tsx scripts/data/build-off-ca.ts"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/"
    ]
  },
  "dependencies": {
    "@expo/ui": "~57.0.20",
    "@kingstinct/react-native-healthkit": "^16.0.0",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
